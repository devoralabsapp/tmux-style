  "actions": [
    {
      "id": "User.TmuxStyle.SplitRight",
      "name": "Workspace: split right",
      "command": {
        "action": "splitPane",
        "split": "right",
        "splitMode": "duplicate"
      }
    },
    {
      "id": "User.TmuxStyle.SplitDown",
      "name": "Workspace: split below",
      "command": {
        "action": "splitPane",
        "split": "down",
        "splitMode": "duplicate"
      }
    },
    {
      "id": "User.TmuxStyle.Zoom",
      "name": "Workspace: zoom / restore pane",
      "command": "togglePaneZoom"
    },
    {
      "id": "User.TmuxStyle.NewTab",
      "name": "Workspace: new tab",
      "command": "newTab"
    },
