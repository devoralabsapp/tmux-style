      "command": {
        "action": "moveFocus",
        "direction": "down"
      }
    },
    {
      "id": "User.TmuxStyle.ResizeDown",
      "name": "Workspace: resize down",
      "command": {
        "action": "resizePane",
        "direction": "down"
      }
    },
    {
      "id": "User.TmuxStyle.FocusUp",
      "name": "Workspace: focus up",
      "command": {
        "action": "moveFocus",
        "direction": "up"
      }
    },
    {
      "id": "User.TmuxStyle.ResizeUp",
      "name": "Workspace: resize up",
      "command": {
        "action": "resizePane",
        "direction": "up"
      }
    },
    {
      "id": "User.TmuxStyle.FocusRight",
      "name": "Workspace: focus right",
      "command": {
        "action": "moveFocus",
        "direction": "right"
      }
    },
    {
      "id": "User.TmuxStyle.ResizeRight",
      "name": "Workspace: resize right",
      "command": {
        "action": "resizePane",
        "direction": "right"
      }
    },
    {
      "id": "User.TmuxStyle.Layout",
      "name": "Workspace: create 3-pane layout",
      "command": {
        "action": "multipleActions",
        "actions": [
          {
            "action": "newTab"
          },
          {
            "action": "splitPane",
            "split": "right",
            "splitMode": "duplicate",
            "size": 0.35
          },
          {
            "action": "splitPane",
            "split": "down",
            "splitMode": "duplicate",
            "size": 0.5
          },
          {
            "action": "moveFocus",
            "direction": "first"
          }
        ]
      }
    },
    {
      "id": "User.TmuxStyle.DuplicateTab",
      "name": "Workspace: new tab in current profile and directory",
      "command": "duplicateTab"
    },
    {
      "id": "User.TmuxStyle.RenameTab",
      "name": "Workspace: rename current tab",
      "command": {
        "action": "renameTab"
      }
    },
